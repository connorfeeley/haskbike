HASKBIKE_PGDBHOST=localhost
HASKBIKE_PGDBPORT=5432
HASKBIKE_USERNAME=my_postgres_username
HASKBIKE_PASSWORD=my_postgres_password
# Optional: maximum number of pooled Postgres connections. Defaults to
# the GHC RTS `numCapabilities` (number of CPU cores). Raise this if
# burst load is queueing on the pool — Postgres typically tolerates
# 2-3x core count without contention.
# HASKBIKE_PG_POOL_SIZE=32

NIX_AARCH64_BUILDER="ssh-ng://my-host x86_64-linux,aarch64-linux"
DOCKER_TAG="my-aws-id.dkr.ecr.my-aws-region.amazonaws.com/haskbike"